#include <stdio.h>

int main() {
    int choice;
    float num1, num2, result;

    // Input two numbers
    printf("Enter any 2 numbers: ");
    scanf("%f %f", &num1, &num2);

    // Display menu
    printf("\n1. Addition\n");
    printf("2. Subtraction\n");
    printf("3. Multiplication\n");
    printf("4. Division\n");
    printf("Enter choice for operation to be performed: ");
    scanf("%d", &choice);

    // Perform operation using switch-case
    switch (choice) {
        case 1:
            result = num1 + num2;
            printf("Addition is=%.0f\n", result);
            break;

        case 2:
            result = num1 - num2;
            printf("Subtraction is=%.0f\n", result);
            break;

        case 3:
            result = num1 * num2;
            printf("Multiplication is=%.0f\n", result);
            break;

        case 4:
            if (num2 != 0) {
                result = num1 / num2;
                printf("Division is=%.2f\n", result);
            } else {
                printf("Error: Division by zero is not allowed.\n");
            }
            break;

        default:
            printf("Invalid choice!\n");
    }

    return 0;
}
